# -----------------------------------------------------------------------------
# Gemeinsamer Host + Ports (lokaler Zugriff ohne Proxy)
# -----------------------------------------------------------------------------
# HOST ist die gemeinsame Host-URL für die erzeugten Links.
# Für lokale Tests auf demselben Rechner bleibt 127.0.0.1 ideal.
HOST=127.0.0.1

# Interner Bind-Host für Container/Server. Nicht für Domain-Links gedacht.
BIND_HOST=0.0.0.0
# Host-Bind des veröffentlichten Kalender-Ports. Für externen Testzugriff: 0.0.0.0.
APP_BIND_HOST=0.0.0.0

PORT=3000
NODE_ENV=production

# Lokale Ports:
CAL11_PORT=3000
VP_PORT=8000
NTFY_PORT=8090
# Für Zugriff nur vom selben Rechner: 127.0.0.1. Für LAN/Container-Zugriff: 0.0.0.0.
NTFY_BIND_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# MariaDB (gemeinsame DB für Kalender + VP)
# -----------------------------------------------------------------------------
DB_HOST=mariadb
DB_PORT=3306
DB_USER=cal11user

# WICHTIG: eigene starke Passwörter setzen
DB_PASSWORD=
DB_ROOT_PASSWORD=

DB_NAME=cal11

# Portweiterleitung der Datenbank auf den Host (z. B. für DataGrip / DBeaver)
HOST_DB_PORT=127.0.0.1:3306

# Optional: direkter Verbindungs-String (überschreibt Host/Port/User/Pass/Name)
# APP_DATABASE_URL=mariadb://cal11user:@mariadb:3306/cal11

# -----------------------------------------------------------------------------
# VP-App / Sicherheit / Schulzugang
# -----------------------------------------------------------------------------
# WICHTIG: mit Fernet erzeugen:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Separates Passwort für das geschützte Admin-Popup.
# Nicht die normale 4-stellige PIN verwenden; mindestens 12 zufällige Zeichen.
# Beispiel: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PANEL_PASSWORD=

# Default-Klasse für automatisch angelegte VP-Profile aus Kalender-Login
VP_DEFAULT_CLASS=11

# Stundenplan24-Zugangsdaten (Pflicht für Planabruf)
SCHULNUMMER=
BENUTZERNAME=
PASSWORT=

# -----------------------------------------------------------------------------
# Öffentliche URLs (für Links, Cookies, ntfy-App)
# -----------------------------------------------------------------------------
# Lokal (ohne HTTPS) kannst du z.B. nutzen:
CALENDAR_PUBLIC_URL=http://127.0.0.1:3000
VERTRETUNGSPLAN_PUBLIC_URL=http://127.0.0.1:8000
NTFY_PUBLIC_URL=http://127.0.0.1:8090

# Produktion (HTTPS):
# CALENDAR_PUBLIC_URL=https://cal11.de
# VERTRETUNGSPLAN_PUBLIC_URL=https://vp.cal11.de
# NTFY_PUBLIC_URL=https://notify.cal11.de

# Interner ntfy-Endpunkt aus dem VP-Container
NTFY_INTERNAL_URL=http://ntfy

# -----------------------------------------------------------------------------
# Reverse Proxy / TLS (Produktion)
# -----------------------------------------------------------------------------
# WICHTIG: true setzen, wenn ntfy hinter einem Reverse Proxy (Caddy/nginx/...)
# läuft, z.B. bei notify.cal11.de aus proxy/Caddyfile! Ohne dies wertet ntfy
# für das Rate-Limiting die Proxy-IP statt der echten Client-IP aus
# X-Forwarded-For aus - dann teilen sich ALLE Nutzer (und der App-Backend-
# Worker) ein einziges Rate-Limit-Kontingent, was schnell zu unnötigen
# HTTP 429 ("Too Many Requests") führt, obwohl die Anfragen tatsächlich von
# vielen verschiedenen echten Clients stammen.
# Für reines lokales Testen ohne Proxy: false.
NTFY_BEHIND_PROXY=false

# Für öffentliche HTTPS-Instanzen IMMER true.
# Für reines localhost-Testing ohne HTTPS auf false setzen.
COOKIE_SECURE=false

# E-Mail für Let's Encrypt (Caddyfile nutzt {$TLS_EMAIL})
TLS_EMAIL=

# ntfy-Default-Zugriff (lokal meist read-write; in restriktiven Setups anpassen)
NTFY_AUTH_DEFAULT_ACCESS=read-write

# ntfy Rate-Limiting (pro erkannter Client-IP, siehe NTFY_BEHIND_PROXY oben).
# Nur als zusätzliches Sicherheitsnetz gegen kurzzeitige Bursts gedacht (z.B.
# viele Nutzer gleichzeitig zur selben Stundenwechsel-Zeit). Ist
# NTFY_BEHIND_PROXY korrekt gesetzt, reichen meist auch die ntfy-Standardwerte
# (burst: 60, replenish: 5s) aus.
NTFY_VISITOR_REQUEST_LIMIT_BURST=120
NTFY_VISITOR_REQUEST_LIMIT_REPLENISH=5s

# Nur relevant für lokale Sonderfälle; im Docker-Stack bleibt ntfy über Compose aktiv.
NTFY_AUTOSTART=true
NTFY_COMPOSE_FILE=ntfy-compose.yml
NOTIFICATION_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Optionale Container- & Volume-Namen (z. B. für parallele Test-Umgebungen)
# -----------------------------------------------------------------------------
MARIADB_CONTAINER_NAME=mariadb
APP_CONTAINER_NAME=cal11_app
NTFY_CONTAINER_NAME=vpmobil-ntfy
VP_CONTAINER_NAME=cal11_vp
NTFY_PROVISIONER_CONTAINER_NAME=vpmobil-ntfy-provisioner
DB_VOLUME_NAME=mariadb_data
DOCKER_NET_NAME=cal11_net

# -----------------------------------------------------------------------------
# Raumlisten (JSON-Arrays, optional)
# -----------------------------------------------------------------------------
# Beispiele:
# GOOD_ROOMS=["A101","A102"]
# MEDIUM_ROOMS=["B201"]
# BAD_ROOMS=["C301"]
# ALL_ROOMS=["A101","A102","B201","C301"]

GOOD_ROOMS=[]
MEDIUM_ROOMS=[]
BAD_ROOMS=[]
ALL_ROOMS=[]
