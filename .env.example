# -----------------------------------------------------------------------------
# Host-Adressen + Ports (Docker, lokal oder hinter Reverse Proxy)
# -----------------------------------------------------------------------------
# WICHTIG: Nicht alle HOST-Werte auf 127.0.0.1 setzen!
# Bei nginx AUF DEMSELBEN HOST wie Docker:
# - APP_BIND_HOST, VP_BIND_HOST, NTFY_BIND_HOST: 127.0.0.1 (Host-Portfreigaben).
# - BIND_HOST: 0.0.0.0 (Server muss im Container erreichbar bleiben).
# - DB_HOST: mariadb (Docker-Dienstname, nicht localhost).
# - *_PUBLIC_URL: öffentliche HTTPS-Domains (siehe unten).
# Dazu NTFY_BEHIND_PROXY=true und COOKIE_SECURE=true setzen.
# Start mit ./start-all.sh docker; docker-proxy startet zusätzlich Caddy.
#
# Ein Proxy im selben Docker-Netz nutzt die Dienstnamen app/vp/ntfy direkt.
# Ein Proxy auf einem ANDEREN Rechner erreicht 127.0.0.1 dieses Servers nicht:
# dafür gezielt private Host-Adressen freigeben und den Zugriff beschränken.
#
# HOST ist der Fallback für erzeugte Links, wenn keine öffentliche URL gesetzt ist.
# Mit den unten gesetzten Produktions-URLs kann dieser Wert 127.0.0.1 bleiben.
HOST=127.0.0.1

# Listener INNERHALB der Container: auch hinter nginx auf 0.0.0.0 lassen!
# 127.0.0.1 würde Docker-Portweiterleitungen und Container-Proxys aussperren.
BIND_HOST=0.0.0.0
# Kalender-Port nur auf dem Docker-Host erreichbar (nginx auf demselben Host).
APP_BIND_HOST=127.0.0.1

PORT=3000
NODE_ENV=production

# Lokale Ports:
CAL11_PORT=3000
VP_PORT=8000
# VP-Port nur auf dem Docker-Host erreichbar.
VP_BIND_HOST=127.0.0.1
NTFY_PORT=8090
# ntfy-Port nur auf dem Docker-Host erreichbar; Handys nutzen die HTTPS-Domain.
# Der interne VP-Versand verwendet das Docker-Netz, nicht diese Portfreigabe.
NTFY_BIND_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# MariaDB (gemeinsame DB für Kalender + VP)
# -----------------------------------------------------------------------------
# Container-Verbindung zur Datenbank: Dienstname beibehalten, auch hinter nginx.
DB_HOST=mariadb
DB_PORT=3306
DB_USER=cal11user

# WICHTIG: eigene starke Passwörter setzen
DB_PASSWORD=
DB_ROOT_PASSWORD=

DB_NAME=cal11

# Portweiterleitung der Datenbank auf den Host (z. B. für DataGrip / DBeaver)
HOST_DB_PORT=127.0.0.1:3306

# Optional: direkter Verbindungs-String (überschreibt Host/Port/User/Pass/Name)
# APP_DATABASE_URL=mariadb://cal11user:@mariadb:3306/cal11

# -----------------------------------------------------------------------------
# VP-App / Sicherheit / Schulzugang
# -----------------------------------------------------------------------------
# Zeitzone fuer zeitgesteuerte Benachrichtigungen und lokale Datumswerte.
# Kalenderzeiten werden als Ortszeit dieser Zone interpretiert.
APP_TIMEZONE=Europe/Berlin

# WICHTIG: mit Fernet erzeugen:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Separates Passwort für das geschützte Admin-Popup.
# Nicht die normale 4-stellige PIN verwenden; mindestens 12 zufällige Zeichen.
# Beispiel: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PANEL_PASSWORD=

# Default-Klasse für automatisch angelegte VP-Profile aus Kalender-Login
VP_DEFAULT_CLASS=11

# Stundenplan24-Zugangsdaten (Pflicht für Planabruf)
SCHULNUMMER=
BENUTZERNAME=
PASSWORT=

# -----------------------------------------------------------------------------
# Öffentliche URLs (für Links, Cookies, ntfy-App)
# -----------------------------------------------------------------------------
# Lokal (ohne HTTPS) kannst du z.B. nutzen:
CALENDAR_PUBLIC_URL=http://127.0.0.1:3000
VERTRETUNGSPLAN_PUBLIC_URL=http://127.0.0.1:8000
NTFY_PUBLIC_URL=http://127.0.0.1:8090

# Produktion hinter nginx: die drei lokalen Werte oben durch diese ersetzen.
# Öffentliche URLs NICHT auf 127.0.0.1 setzen, sonst zeigen Handy-Links aufs Handy!
# CALENDAR_PUBLIC_URL=https://cal11.de
# VERTRETUNGSPLAN_PUBLIC_URL=https://vp.cal11.de
# NTFY_PUBLIC_URL=https://notify.cal11.de

# Nur für lokale Ausführung/Sonderinstallationen. Der vollständige Docker-Stack
# verwendet fest http://ntfy-delivery auf einem eigenen internen Netzwerk.
NTFY_INTERNAL_URL=http://ntfy

# -----------------------------------------------------------------------------
# Reverse Proxy / TLS (Produktion)
# -----------------------------------------------------------------------------
# true setzen, wenn ntfy hinter einem Reverse Proxy (Caddy/nginx/...) läuft.
# Damit erkennt ntfy die weitergereichten Client-Adressen. Dies ersetzt nicht
# die separate Ausnahme für den internen VP-Versand (Compose setzt sie automatisch).
# Für lokales Testen ohne Proxy: false.
NTFY_BEHIND_PROXY=false

# Adressen/Netze, von denen aus der Kalender-Webserver (main.py) dem
# X-Forwarded-For-Header vertraut, um die echte Client-IP zu ermitteln
# (Login-Rate-Limiting, Protokollierung). Kommagetrennt, IPs oder CIDR-Netze
# (z.B. 172.18.0.0/16). Muss die Adresse enthalten, von der aus nginx/der
# Reverse Proxy die Anfrage weiterleitet.
# Läuft der Kalender-Container in Docker und nginx auf dem Host über den
# veröffentlichten Port, kommt die Verbindung vom Docker-Bridge-Gateway an,
# nicht von 127.0.0.1 - dann hier das Bridge-Netz eintragen
# (siehe `docker network inspect cal11_net`).
TRUSTED_PROXIES=127.0.0.1,::1

# Für öffentliche HTTPS-Instanzen IMMER true.
# Für reines localhost-Testing ohne HTTPS auf false setzen.
COOKIE_SECURE=false

# E-Mail für Let's Encrypt (Caddyfile nutzt {$TLS_EMAIL})
TLS_EMAIL=

# Private Topics: deny-all beibehalten; Zugänge werden automatisch provisioniert.
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# Limits für öffentliche Anfragen; interner VP-Versand ist separat ausgenommen.
NTFY_VISITOR_REQUEST_LIMIT_BURST=120
NTFY_VISITOR_REQUEST_LIMIT_REPLENISH=5s

# Gleichzeitig offene Abos, KEIN Limit für das Senden von Testnachrichten.
NTFY_VISITOR_SUBSCRIPTION_LIMIT=250

# Optional: dediziertes internes Netz für den zuverlässigen Versand in Compose.
# Nur ändern, falls dieses Netz bereits im LAN/VPN/Docker belegt ist.
# Subnetz und beide unterschiedlichen IPs müssen zusammenpassen.
# NTFY_DELIVERY_SUBNET=172.30.251.0/29
# NTFY_DELIVERY_SERVER_IP=172.30.251.2
# NTFY_DELIVERY_VP_IP=172.30.251.3

# Nur relevant für lokale Sonderfälle; im Docker-Stack bleibt ntfy über Compose aktiv.
NTFY_AUTOSTART=true
NTFY_COMPOSE_FILE=ntfy-compose.yml
# Effektiver Mindestwert: 15 Sekunden. Normaler Versand im nächsten Worker-Durchlauf.
NOTIFICATION_INTERVAL_SECONDS=60
# INFO: Versand/Fehler + Worker-Lebenszeichen alle 15 Minuten.
# DEBUG: zusätzlich Zeitplanung je Nutzer und Durchlauf; nur vorübergehend nutzen.
NTFY_LOG_LEVEL=INFO
# Optional: normalerweise weglassen, Passwort wird aus APP_ENCRYPTION_KEY abgeleitet.
# NTFY_SERVER_USERNAME=vpmobil_server
# NTFY_SERVER_PASSWORD=

# -----------------------------------------------------------------------------
# Optionale Container- & Volume-Namen (z. B. für parallele Test-Umgebungen)
# -----------------------------------------------------------------------------
MARIADB_CONTAINER_NAME=mariadb
APP_CONTAINER_NAME=cal11_app
NTFY_CONTAINER_NAME=vpmobil-ntfy
VP_CONTAINER_NAME=cal11_vp
NTFY_PROVISIONER_CONTAINER_NAME=vpmobil-ntfy-provisioner
DB_VOLUME_NAME=mariadb_data
DOCKER_NET_NAME=cal11_net

# -----------------------------------------------------------------------------
# Raumlisten (JSON-Arrays, optional)
# -----------------------------------------------------------------------------
# Beispiele:
# GOOD_ROOMS=["A101","A102"]
# MEDIUM_ROOMS=["B201"]
# BAD_ROOMS=["C301"]
# ALL_ROOMS=["A101","A102","B201","C301"]

GOOD_ROOMS=[]
MEDIUM_ROOMS=[]
BAD_ROOMS=[]
ALL_ROOMS=[]
